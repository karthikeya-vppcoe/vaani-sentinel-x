# Vaani Sentinel X Environment Configuration
# Copy this file to .env and fill in your actual values

# Environment (development, staging, production)
ENVIRONMENT=development

# API Keys (Required for full functionality)
GROQ_API_KEY=your-groq-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Security Configuration (REQUIRED for production)
JWT_SECRET=your-jwt-secret-key-here-minimum-32-chars
SECRET_KEY=your-flask-secret-key-here-minimum-32-chars
ENCRYPTION_KEY=your-encryption-key-here

# Web Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=false

# Agent Configuration
DEFAULT_LANGUAGES=en
DEFAULT_SENTIMENT=neutral
MAX_CONTENT_LENGTH=4000
PIPELINE_TIMEOUT=300

# Database Configuration
SQLITE_DB_PATH=data/vaani.db
SCHEDULER_DB_DIR=scheduler_db
ANALYTICS_DB_DIR=analytics_db

# Directory Configuration (optional - defaults will be used)
ROOT_DIR=.
CONTENT_DIR=content
RAW_DIR=content/raw
STRUCTURED_DIR=content/structured
MULTILINGUAL_READY_DIR=content/multilingual_ready
CONTENT_READY_DIR=content/content_ready
CONTENT_FINAL_DIR=content/content_final
LOGS_DIR=logs
ARCHIVES_DIR=archives
SCHEDULED_POSTS_DIR=scheduled_posts
CONFIG_DIR=config

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5

# Security Configuration
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Development/Testing (set to true only in development)
ENABLE_DEBUG_ENDPOINTS=false
MOCK_EXTERNAL_APIS=false